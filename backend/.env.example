# make setup generates backend/.env with random, local-only credentials.
DATABASE_URL=postgresql+psycopg://ecommerce:replace-me@localhost:5432/ecommerce
POSTGRES_PASSWORD=replace-me
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional dedicated server-to-server anonymous limiter key (same in paired API/frontend).
# Use at least 32 random characters; never NEXT_PUBLIC_, JWT or protection-bypass key.
# Keep blank locally. Hosted visitor isolation requires paired configuration.
RATE_LIMIT_PROXY_SECRET=
# Production defaults; disposable browser fixtures override their own limits.
RATE_LIMIT_AUTH_REGISTER=60
RATE_LIMIT_AUTH_LOGIN=60
RATE_LIMIT_WRITE=300

# Optional VIN-30 sandbox payments. Leave disabled for the non-payment demo.
# Use a restricted test key stored in the hosting provider's sensitive variables.
STRIPE_ENABLED=false
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_ORIGIN=
