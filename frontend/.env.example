# Server-side only; never use NEXT_PUBLIC_ for credentials or private API URLs.
API_BASE_URL=http://127.0.0.1:8000

# Explicit browser origin; production must use its HTTPS origin.
APP_ORIGIN=http://127.0.0.1:3000
# Local loopback HTTP only; omit on hosted deployments.
ALLOW_LOCAL_HTTP_SESSIONS=true

# Optional exact HTTPS aliases on hosted deployments, JSON array; never wildcards.
APP_ORIGIN_ALIASES=[]

# Optional dedicated server-to-server anonymous limiter key (same in paired API/frontend).
# Use at least 32 random characters; never NEXT_PUBLIC_, JWT or protection-bypass key.
# Keep blank locally. Hosted visitor isolation requires paired configuration.
RATE_LIMIT_PROXY_SECRET=

# Development sandbox only: fixed Stripe webhook relay to the protected API.
STRIPE_WEBHOOK_RELAY_ENABLED=false
# VERCEL_PROTECTION_BYPASS is server-only, supplied securely on hosting.
