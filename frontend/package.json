{
  "name": "ecommerce-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.1"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/patch-next-image.test.mjs && vitest run --coverage",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript openapi.json -o src/lib/api/schema.d.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- openapi.json src/lib/api/schema.d.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "postinstall": "node scripts/patch-next-image.mjs",
    "prebuild": "node scripts/patch-next-image.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "openapi-fetch": "0.17.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "type": "module"
}
